# ==============================================================================
# SAPIENSIA CLAN — CONFIGURACIÓN DEL DESPACHADOR DE ÉTER (REDDIT API)
# Archivo: tools/despachador_eter/.env
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a '.env'
# 2. Entra en https://www.reddit.com/prefs/apps con tu cuenta de Reddit.
# 3. Haz clic en "create another app..." (abajo del todo).
# 4. Selecciona el tipo "script".
# 5. Rellena:
#    - name: DespachadorEter
#    - redirect uri: http://localhost:8080
# 6. Copia el Client ID (debajo del nombre de la app) y el Client Secret.
# ==============================================================================

REDDIT_CLIENT_ID=TU_CLIENT_ID_AQUI
REDDIT_CLIENT_SECRET=TU_CLIENT_SECRET_AQUI
REDDIT_USERNAME=TU_USUARIO_REDDIT
REDDIT_PASSWORD=TU_CONTRASENA_REDDIT
REDDIT_USER_AGENT=SapiensiaClanDispatcher/1.0 by u/TU_USUARIO_REDDIT

# Modo de prueba por defecto (True = no publica en real, solo valida formato y ritmo)
DRY_RUN=True
